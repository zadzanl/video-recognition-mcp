{
  "name": "mcp-video-recognition",
  "version": "1.0.0",
  "description": "MCP server for Google Gemini and OpenAI-compatible image, audio, and video recognition",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist/index.*",
    "dist/server.*",
    "dist/services/**",
    "dist/tools/**",
    "dist/types/**",
    "dist/utils/**",
    "config/**",
    "mcp-json-example/**",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w & node --watch dist/index.js",
    "debug": "tsc & npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint src",
    "test": "tsc && node --test dist/tests/logger.test.js dist/tests/provider-config.test.js dist/tests/fallback.test.js dist/tests/routing.test.js dist/tests/parallel-dispatcher.test.js dist/tests/tool-parallel.test.js dist/tests/openai-compatible-provider.test.js dist/tests/server-transport.test.js dist/tests/media.test.js"
  },
  "keywords": [
    "mcp",
    "gemini",
    "openai-compatible",
    "video",
    "audio",
    "image",
    "recognition"
  ],
  "author": "mario-andreschak",
  "repository": {
    "type": "git",
    "url": "https://github.com/mario-andreschak/mcp_video_recognition.git"
  },
  "homepage": "https://github.com/mario-andreschak/mcp_video_recognition#readme",
  "bugs": {
    "url": "https://github.com/mario-andreschak/mcp_video_recognition/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.10.1",
    "express": "^5.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1"
  }
}
