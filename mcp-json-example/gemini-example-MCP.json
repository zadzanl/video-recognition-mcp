{
  "inputs": [
    {
      "id": "google-api-key",
      "type": "promptString",
      "description": "Google Gemini API key",
      "password": true
    }
  ],
  "servers": {
    "video-recognition": {
      "type": "stdio",
      "command": "node",
      "args": [
        "C:/absolute/path/to/video-recognition-mcp/dist/index.js"
      ],
      "env": {
        "RECOGNITION_PROVIDER": "gemini",
        "GOOGLE_API_KEY": "${input:google-api-key}",
        "PARALLEL_PROMPTS": "1",
        "PARALLEL_AGGREGATION": "all_return",
        "LOG_LEVEL": "fatal"
      }
    }
  }
}